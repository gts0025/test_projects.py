

import numpy as np, matplotlib.pyplot as plt
def lapalcian(u):
    dux  = (u[2:] + u[:-2] - 2*u[1:-1])
    zeros = np.zeros_like(u)
    zeros[1:-1] = dux 
    return zeros

u = np.zeros(200)
u[75:125] = np.exp(-np.linspace(-2,2,50)**2)



def wave_Euler(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    for i in range(steps):
        d2ux = lapalcian(u)
        dct =  d2ux
        dut =  c
        
        u += dut*dt
        c += dct*dt
        
    return u,c

def wave_coupled_Euler(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    for i in range(steps):
        d2ux = lapalcian(u)
        c += d2ux*dt
        u += c*dt
        c[0] = 0
        c[-1] = 0
        
        
    return u,c

def wave_Kutta2(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    
    for i in range(steps):
        
        kc1 = lapalcian(u)
        kx1 = c
        
        nu = u + kx1*dt
        nc = c + kc1*dt

        kc2 = lapalcian(nu)
        kx2 = nc      

        c += dt*(kc1 + kc2)/2
        u += dt*(kx1 + kx2)/2
        
        c[0] = 0
        c[-1] = 0
        
       

    return u,c



def Kutta4(u0,c0,dt,steps):
    u = u0[:]
