# explosion test in diffusion equation

import numpy as np, matplotlib.pyplot as plt
def lapalcian(u):
    dux  = (u[2:] + u[:-2] - 2*u[1:-1])
    zeros = np.zeros_like(u)
    zeros[1:-1] = dux 
    return zeros

u = np.zeros(100)
u[45:55] = 1


def implicit_Euler(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    for i in range(steps):
        d2ux = lapalcian(u)
        c += d2ux*dt
        c[0] = 0
        c[-1] = 0
        u += c*dt
        
    return u,c

def explicit_Euler(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    for i in range(steps):
        d2ux = lapalcian(u)
        u += c*dt
        c += d2ux*dt
        c[0] = 0
        c[-1] = 0
        
        
    return u,c

def Kutta2(u0,c0,dt,steps):
    u = u0[:]
    c = c0[:]
    
    for i in range(steps):
        
        kc1 = lapalcian(u)
        kx1 = c
        
        nu = u + kx1*dt
        nc = c + kc1*dt

        kc2 = lapalcian(nu)
        kx2 = nc      

        c += dt*(kc1 + kc2)/2
        u += dt*(kx1 + kx2)/2
        
        c[0] = 0
        c[-1] = 0
        
       

    return u,c





